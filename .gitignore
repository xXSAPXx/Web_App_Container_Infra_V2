
##################### Terraform Ignore ######################

# Ignore tfvars.file
IaC/terraform-app-stack/*.tfvars
IaC/terraform-ecr-repos/*.tfvars

# Ignore Terraform working directory
IaC/terraform-app-stack/.terraform/
IaC/terraform-ecr-repos/.terraform/

# Ignore Terraform state files
IaC/terraform-app-stack/*.tfstate
IaC/terraform-app-stack/*.tfstate.backup
IaC/terraform-ecr-repos/*.tfstate
IaC/terraform-ecr-repos/*.tfstate.backup

# Ignore crash logs and plan files. .terraform.lock.hcl is deliberately
# NOT ignored - it pins exact provider versions + checksums for every
# machine and CI (HashiCorp's recommendation), so providers only change
# through reviewed PRs (Dependabot updates it).
IaC/terraform-app-stack/crash.log
IaC/terraform-app-stack/tfplan
IaC/terraform-ecr-repos/crash.log
IaC/terraform-ecr-repos/tfplan

# Rendered k8s manifests (generated by IaC/deploy-app.sh, contains resolved
# infra values - not meant to be tracked)
k8s/rendered/



################### Backend Docker Ignore ###################
backend/node_modules/
backend/dist/
backend/*.log
backend/.env


