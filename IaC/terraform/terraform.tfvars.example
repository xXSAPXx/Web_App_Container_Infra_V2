
# Create a file named terraform.tfvars (Ignored in .gitignore) in /terraform direcroy in your local repo with the needed TF variables:
# TF_VARS:

# Cloudflare Variables:
cloudflare_api_token       = <EXAMPLE>
cloudflare_zone_id         = <EXAMPLE>
cloudflare_domain_name     = <EXAMPLE>

# Key pair for the EC2 instances
aws_key_pair               = <EXAMPLE>

# Cloudflare DNS is now kept in sync automatically by external-dns running
# in-cluster (see helm_release.external_dns in main.tf) - no DNS variable
# needed here anymore.