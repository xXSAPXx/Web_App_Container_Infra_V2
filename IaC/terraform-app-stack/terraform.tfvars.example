
# Create a file named terraform.tfvars (Ignored in .gitignore) in /terraform-app-stack directory in your local repo with the needed TF variables:
# TF_VARS:

# Cloudflare Variables:
cloudflare_api_token       = <EXAMPLE>
cloudflare_zone_id         = <EXAMPLE>
cloudflare_domain_name     = <EXAMPLE>

# Key pair for the EC2 instances
aws_key_pair               = <EXAMPLE>

# Backend DB credentials - must match whatever admin user/password already
# exists inside the restored RDS snapshot (Terraform can't derive these).
# Used to create the backend-db-secret Kubernetes Secret automatically.
rds_db_username             = <EXAMPLE>
rds_db_password             = <EXAMPLE>

# Cloudflare DNS is now kept in sync automatically by external-dns running
# in-cluster (see helm_release.external_dns in main.tf) - no DNS variable
# needed here anymore.

# Tailscale ephemeral, reusable auth key - generate at
# https://login.tailscale.com/admin/settings/keys
tailscale_authkey          = <EXAMPLE>

# Tailscale OAuth client for the Kubernetes operator (exposes Grafana onto
# the tailnet) - two setup steps first, both one-time in the admin console:
#
# 1) Add the tag:k8s-operator/tag:k8s tags to the tailnet's ACL policy
#    (https://login.tailscale.com/admin/acls) - they don't exist by default
#    on a fresh tailnet, and the OAuth client below can't be tagged with a
#    tag that doesn't exist yet:
#      "tagOwners": {
#        "tag:k8s-operator": [],
#        "tag:k8s": ["tag:k8s-operator"]
#      }
#    tag:k8s-operator is what the operator itself runs as; tag:k8s is what
#    it tags the proxy devices it creates with (Grafana's, and any future
#    one) - the second line makes the operator an owner of tag:k8s so it's
#    actually allowed to hand that tag to the devices it creates.
#
# 2) Create the OAuth client itself at
#    https://login.tailscale.com/admin/settings/oauth - write scope on
#    General/Services, Devices/Core, and Keys/Auth Keys, tagged
#    tag:k8s-operator (not tag:k8s - that's for the proxies, not the
#    operator itself).
tailscale_oauth_client_id     = <EXAMPLE>
tailscale_oauth_client_secret = <EXAMPLE>

# Your personal IP as a /32 - the only address allowed to SSH into the
# bastion directly (Tailscale is the real access path; this is a
# break-glass fallback). Find it with: curl.exe -s https://api.ipify.org
my_ip_cidr                    = <EXAMPLE>

# Resource tags (applied to everything via default_tags in main.tf).
# Environment: one of dev, stage, prod (validated).
# Owner: the team or handle responsible for this infra.
# Repository: where this infra is defined, as "owner/repo".
environment                   = <EXAMPLE>
owner                         = <EXAMPLE>
repository                    = <EXAMPLE>